# Frontend build configuration. Public, not secrets.
NEXT_PUBLIC_API_BASE=https://your-api.example/portal
NEXT_PUBLIC_API_FALLBACKS=
NEXT_PUBLIC_BASE_PATH=

# Deno API ONLY: never expose through NEXT_PUBLIC_*.
# DB_URL=postgresql://user:password@127.0.0.1:5432/ktpp
# ADMIN_PASSWORD=<strong-unique-password>
# Alternative for a fresh installation: single-purpose setup code.
# ADMIN_SETUP_TOKEN=<random-secret>

# DATABASE_URL is used only by the legacy Next.js backend / old tooling.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/ktpp
