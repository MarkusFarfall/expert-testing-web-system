{
  "name": "expert-testing-web-system",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/api-client.test.mjs",
    "test:bot": "python3 bot/bot.py --selftest && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "build:test": "NEXT_PUBLIC_API_BASE=/test-api NEXT_PUBLIC_API_FALLBACKS= next build",
    "test:ui": "node tests/run-ui.mjs",
    "check": "npm run lint && next typegen && npm run typecheck && npm run test:unit && npm run test:bot"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.64.0",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.0",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "description": "Русскоязычная платформа тестирования «Экспертиза КТПП»: Next.js App Router + PostgreSQL + Drizzle ORM"
}
